    "%@ is already used by %@.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ já é usado por %2$@."
          }
        }
      }
    },
    "%@ needs ⌃, ⌥ or ⌘.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ precisa de ⌃, ⌥ ou ⌘."
          }
        }
      }
    },
    "%@ of the display is in no zone. Windows can’t snap there.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ do monitor não está em nenhuma zona. As janelas não se encaixam ali."
