      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonas"
          }
        }
      }
    },
    "Zones %lld and %lld overlap.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As zonas %1$lld e %2$lld se sobrepõem."
          }
        }
      }
    },
    "Zones 1 to 9": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonas 1 a 9"
          }
        }
      }
    },
    "macOS also offers its own tiling while you drag with Option held.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS também organiza janelas por conta própria quando você arrasta segurando Option."
          }
        }
      }
    },
    "macOS turned off Accessibility for this copy of EpycZones, as it does after some updates. Turn it on again to keep snapping windows.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS desativou a Acessibilidade desta cópia do EpycZones, como acontece depois de algumas atualizações. Ative de novo para continuar encaixando janelas."
          }
        }
      }
    },
    "“%@” will be removed. Your windows stay where they are.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” será removido. As suas janelas ficam onde estão."
          }
        }
      }
    },
    "“%@” will use the default layout if you connect it again.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” vai usar o layout padrão se você conectá-lo de novo."
          }
        }
      }
