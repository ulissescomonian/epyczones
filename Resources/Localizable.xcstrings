    "Wait before showing": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera antes de mostrar"
          }
        }
      }
    },
    "Welcome to EpycZones": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Boas-vindas ao EpycZones"
          }
        }
      }
    },
    "When EpycZones opens, windows you snapped to a zone go back to it.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o EpycZones abre, as janelas que você encaixou numa zona voltam para ela."
          }
        }
      }
    },
    "Windows": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas"
          }
        }
      }
    },
    "Windows can’t snap until EpycZones is allowed.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas não se encaixam até você permitir o EpycZones."
          }
        }
      }
    },
    "Windows glide into place instead of jumping.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas deslizam até o lugar em vez de saltar."
          }
        }
      }
    },
    "Windows keep this distance from each other and from the edges of their zone.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas mantêm esta distância umas das outras e das bordas da zona."
          }
        }
      }
    },
    "Work, Writing, Review…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
