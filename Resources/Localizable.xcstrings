    "Zone %lld": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona %lld"
          }
        }
      }
    },
    "Zone numbers follow the layout of the display where the window opens.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números das zonas seguem o layout do monitor onde a janela abre."
          }
