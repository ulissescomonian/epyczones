            "value": "Usado por um monitor sem layout próprio, como um que você conecta pela primeira vez."
          }
        }
      }
    },
    "Used on %@.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado em %@."
          }
        }
      }
    },
